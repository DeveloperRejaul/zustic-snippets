{
  "Interface": {
    "prefix": "iface",
    "body": [
      "interface $1 {",
      "  $2: $3;",
      "}"
    ],
    "description": "TypeScript interface"
  },
  "Type Alias": {
    "prefix": "type",
    "body": [
      "type $1 = $2;"
    ],
    "description": "TypeScript type alias"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "enum $1 {",
      "  $2,",
      "  $3",
      "}"
    ],
    "description": "TypeScript enum"
  },
  "Generic Interface": {
    "prefix": "ifacegeneric",
    "body": [
      "interface $1<T> {",
      "  $2: T;",
      "}"
    ],
    "description": "Generic TypeScript interface"
  },
  "Generic Type": {
    "prefix": "typegeneric",
    "body": [
      "type $1<T> = $2;"
    ],
    "description": "Generic TypeScript type"
  },
  "Generic Function": {
    "prefix": "funcgeneric",
    "body": [
      "function $1<T>($2: T): T {",
      "  $3",
      "}"
    ],
    "description": "Generic function"
  },
  "Typed Arrow Function": {
    "prefix": "aftyped",
    "body": [
      "const $1 = ($2: $3): $4 => {",
      "  $5",
      "};"
    ],
    "description": "Typed arrow function"
  },
  "Class with Types": {
    "prefix": "classt",
    "body": [
      "class $1 {",
      "  private $2: $3;",
      "",
      "  constructor($4: $5) {",
      "    this.$2 = $4;",
      "  }",
      "",
      "  get $2(): $3 {",
      "    return this.$2;",
      "  }",
      "}"
    ],
    "description": "Typed class with getter"
  },
  "Union Type": {
    "prefix": "union",
    "body": [
      "type $1 = $2 | $3;"
    ],
    "description": "Union type"
  },
  "Intersection Type": {
    "prefix": "intersection",
    "body": [
      "type $1 = $2 & $3;"
    ],
    "description": "Intersection type"
  },
  "Readonly Property": {
    "prefix": "readonly",
    "body": [
      "readonly $1: $2;"
    ],
    "description": "Readonly property"
  },
  "Partial": {
    "prefix": "partial",
    "body": [
      "type $1 = Partial<$2>;"
    ],
    "description": "Partial utility type"
  },
  "Required": {
    "prefix": "required",
    "body": [
      "type $1 = Required<$2>;"
    ],
    "description": "Required utility type"
  },
  "Record": {
    "prefix": "record",
    "body": [
      "type $1 = Record<$2, $3>;"
    ],
    "description": "Record utility type"
  },
  "Pick": {
    "prefix": "pick",
    "body": [
      "type $1 = Pick<$2, '$3'>;"
    ],
    "description": "Pick utility type"
  },
  "Omit": {
    "prefix": "omit",
    "body": [
      "type $1 = Omit<$2, '$3'>;"
    ],
    "description": "Omit utility type"
  },
  "Keyof": {
    "prefix": "keyof",
    "body": [
      "type $1 = keyof $2;"
    ],
    "description": "Keyof operator"
  },
  "Typed Array": {
    "prefix": "arrtyped",
    "body": [
      "const $1: $2[] = [$3];"
    ],
    "description": "Typed array"
  },
  "Typed Object": {
    "prefix": "objtyped",
    "body": [
      "const $1: { $2: $3 } = {",
      "  $2: $4",
      "};"
    ],
    "description": "Typed object"
  },
  "Function Parameter Type": {
    "prefix": "paramtype",
    "body": [
      "function $1($2: $3): $4 {",
      "  $5",
      "}"
    ],
    "description": "Function with typed parameters"
  },
  "Async Function Typed": {
    "prefix": "asynct",
    "body": [
      "async function $1($2: $3): Promise<$4> {",
      "  $5",
      "}"
    ],
    "description": "Typed async function"
  },
  "Promise Type": {
    "prefix": "promt",
    "body": [
      "new Promise<$1>((resolve, reject) => {",
      "  $2",
      "});"
    ],
    "description": "Typed Promise"
  },
  "Conditional Type": {
    "prefix": "conditional",
    "body": [
      "type $1 = $2 extends $3 ? $4 : $5;"
    ],
    "description": "Conditional type"
  },
  "Mapped Type": {
    "prefix": "mapped",
    "body": [
      "type $1 = {",
      "  [K in keyof $2]: $3",
      "};"
    ],
    "description": "Mapped type"
  },
  "as const": {
    "prefix": "asconst",
    "body": [
      "as const"
    ],
    "description": "as const assertion"
  },
  "Type Guard": {
    "prefix": "typeguard",
    "body": [
      "function is$1($2: unknown): $2 is $1 {",
      "  $3",
      "}"
    ],
    "description": "Type guard function"
  },
  "Discriminated Union": {
    "prefix": "discriminated",
    "body": [
      "type $1 = ",
      "  | { kind: '$2'; $3: $4 }",
      "  | { kind: '$5'; $6: $7 };"
    ],
    "description": "Discriminated union type"
  }
}
