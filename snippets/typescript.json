{
  "Interface Counter Store": {
    "prefix": "zs",
    "body": [
      "import { create } from 'zustic';",
      "",
      "type CounterStore = {",
      "  count: number;",
      "  inc: () => void;",
      "  dec: () => void;",
      "  reset: () => void;",
      "};",
      "",
      "const ${1:useCounter} = create<CounterStore>((set, get) => ({",
      "  count: 0,",
      "  inc: () => set((state) => ({ count: state.count + 1 })),",
      "  dec: () => set({ count: get().count - 1 }),",
      "  reset: () => set({ count: 0 }),",
      "}));"
    ],
    "description": "Zustand counter store with TypeScript interface"
  },

  "Zustic Store with Middleware Logger": {
    "prefix": "zsm",
    "body": [
      "import { type Middleware } from 'zustic';",
      "",
      "type ${1:AppState} = {",
      "  count: number;",
      "  name: string;",
      "};",
      "",
      "const ${2:logger}: Middleware<${1:AppState}> = (set, get) => (next) => async (partial) => {",
      "  // Before update",
      "  console.log('Previous state:', get());",
      "  console.log('Update:', partial);",
      "",
      "  await next(partial);",
      "",
      "  // After update",
      "  console.log('Updated state:', get());",
      "};"
    ],
    "description": "Zustic logger middleware and editable cursor positions"
  },
  "Zustic Base Query": {
    "prefix": "zbq",
    "body": [
      "class Query {",
      "  getHeader(args?: any) {",
      "    const headers = {",
      "      'Content-Type': 'application/json',",
      "      Accept: 'application/json',",
      "      ...(args?.headers || {})",
      "    };",
      "",
      "    return headers;",
      "  }",
      "",
      "  baseQuery = async (args: any) => {",
      "    const timeout = 60000;",
      "    const baseUrl = '${1:https://api.example.com}';",
      "",
      "    const controller = new AbortController();",
      "    const timeoutId = setTimeout(() => controller.abort(), timeout);",
      "",
      "    const url = typeof args === 'string' ? baseUrl + args : baseUrl + args.url;",
      "    try {",
      "      const headers = this.getHeader(args);",
      "",
      "      const response = await fetch(url, {",
      "        method: args?.method || 'GET',",
      "        headers,",
      "        body: args?.formData",
      "          ? args.formData",
      "          : args?.body",
      "          ? JSON.stringify(args.body)",
      "          : undefined,",
      "        signal: controller.signal,",
      "        credentials: 'include'",
      "      });",
      "",
      "      clearTimeout(timeoutId);",
      "",
      "      if (!response.ok) {",
      "        throw (await response.json()) || 'Something went wrong';",
      "      }",
      "",
      "      const data = await response.json();",
      "      return { data };",
      "    } catch (error) {",
      "      console.log(error);",
      "      clearTimeout(timeoutId);",
      "      return { data: error };",
      "    }",
      "  };",
      "}",
      "",
      "export default new Query();"
    ],
    "description": "Zustic base query with TypeScript types"
  },
  "Zustic Query": {
    "prefix": "zq",
    "body": [
       "import { createApi } from 'zustic/query'",
      "import query from '${1:base_query_path}'",
      "",
      "type ${2:ResponseType} = any",
      "type ${3:ParamsType} = any",
      "",
      "const api = createApi({",
      "  // 1. Custom fetch function",
      "  baseQuery: query.baseQuery,",
      "",
      "  // 2. Cache duration",
      "  cacheTimeout: 5 * 60 * 1000,",
      "",
      "  // 3. Define endpoints",
      "  endpoints: (builder) => ({",
      "",
      "    ${4:getUsers}: builder.query<${2}, ${3}>({",
      "      query: () => '/users'",
      "    }),",
      "",
      "    ${5:createUser}: builder.mutation<${2}, ${3}>({",
      "      query: (user) => ({",
      "        url: '/users',",
      "        method: 'POST',",
      "        body: user",
      "      })",
      "    })",
      "",
      "  })",
      "})",
      "",
      "// 4. Auto-generated hooks",
      "export const {",
      "  use${6:GetUsers}Query,",
      "  use${7:CreateUser}Mutation",
      "} = api",
      "",
      "export default api"
     ],
    "description": "Zustic query with TypeScript types"
  }
}