{
  "Interface Counter Store": {
    "prefix": "zs",
    "body": [
      "import { create } from 'zustic';",
      "",
      "const ${1:useCounter} = create((set, get) => ({",
      "  count: 0,",
      "  inc: () => set((state) => ({ count: state.count + 1 })),",
      "  dec: () => set({ count: get().count - 1 }),",
      "  reset: () => set({ count: 0 }),",
      "}));"
    ],
    "description": "Zustic counter store with js"
  },
  "Zustic Logger Middleware": {
    "prefix": "zsm",
    "body": [
      "import { type Middleware } from 'zustic';",
      "",
      "const ${2:logger} = (set, get) => (next) => async (partial) => {",
      "  // Before update",
      "  console.log('Previous state:', get());",
      "  console.log('Update:', partial);",
      "",
      "  await next(partial);",
      "",
      "  // After update",
      "  console.log('Updated state:', get());",
      "};",
      ""
    ],
    "description": "Zustic logger middleware and editable cursor positions"
  },
  "Zustic Base Query": {
    "prefix": "zbq",
    "body": [
      "class Query {",
      "  getHeader(args) {",
      "    const headers = {",
      "      'Content-Type': 'application/json',",
      "      Accept: 'application/json',",
      "      ...(args?.headers || {})",
      "    };",
      "",
      "    return headers;",
      "  }",
      "",
      "  baseQuery = async (args) => {",
      "    const timeout = 60000;",
      "    const baseUrl = '${1:https://api.example.com}';",
      "",
      "    const controller = new AbortController();",
      "    const timeoutId = setTimeout(() => controller.abort(), timeout);",
      "",
      "    const url = typeof args === 'string' ? baseUrl + args : baseUrl + args.url;",
      "",
      "    try {",
      "      const headers = this.getHeader(args);",
      "",
      "      const response = await fetch(url, {",
      "        method: args?.method || 'GET',",
      "        headers,",
      "        body: args?.formData",
      "          ? args.formData",
      "          : args?.body",
      "          ? JSON.stringify(args.body)",
      "          : undefined,",
      "        signal: controller.signal,",
      "        credentials: 'include'",
      "      });",
      "",
      "      clearTimeout(timeoutId);",
      "",
      "      if (!response.ok) {",
      "        throw (await response.json()) || 'Something went wrong';",
      "      }",
      "",
      "      const data = await response.json();",
      "      return { data };",
      "    } catch (error) {",
      "      console.log(error);",
      "      clearTimeout(timeoutId);",
      "      return { data: error };",
      "    }",
      "  };",
      "}",
      "",
      "export default new Query();"
    ],
    "description": "Zustic base query with TypeScript types"
  },
  "Zustic Query": {
    "prefix": "zq",
    "body": [ 
      "import { createApi } from 'zustic/query'",
      "import query from '${1:base_query_path}'",
      "",
      "const api = createApi({",
      "  // 1. Custom fetch function",
      "  baseQuery: query.baseQuery,",
      "",
      "  // 2. Cache duration",
      "  cacheTimeout: 5 * 60 * 1000,",
      "",
      "  // 3. Define endpoints",
      "  endpoints: (builder) => ({",
      "    getUsers: builder.query({",
      "      query: () => '/users'",
      "    }),",
      "",
      "    createUser: builder.mutation({",
      "      query: (user) => ({",
      "        url: '/users',",
      "        method: 'POST',",
      "        body: user",
      "      })",
      "    })",
      "  })",
      "})",
      "",
      "// 4. Auto-generated hooks",
      "export const { useGetUsersQuery, useCreateUserMutation } = api",
      "",
      "export default api"  
    ],
    "description": "Zustic query with TypeScript types"
  }
}