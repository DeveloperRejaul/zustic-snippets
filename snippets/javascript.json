{
  "Console Log": {
    "prefix": "log",
    "body": [
      "console.log($1);"
    ],
    "description": "Log output to console"
  },
  "Console Error": {
    "prefix": "err",
    "body": [
      "console.error($1);"
    ],
    "description": "Log error to console"
  },
  "Console Warn": {
    "prefix": "warn",
    "body": [
      "console.warn($1);"
    ],
    "description": "Log warning to console"
  },
  "Console Table": {
    "prefix": "table",
    "body": [
      "console.table($1);"
    ],
    "description": "Display table in console"
  },
  "Arrow Function": {
    "prefix": "af",
    "body": [
      "const $1 = ($2) => {",
      "  $3",
      "};"
    ],
    "description": "Arrow function"
  },
  "Async Arrow Function": {
    "prefix": "aaf",
    "body": [
      "const $1 = async ($2) => {",
      "  $3",
      "};"
    ],
    "description": "Async arrow function"
  },
  "Promise": {
    "prefix": "prom",
    "body": [
      "new Promise((resolve, reject) => {",
      "  $1",
      "});"
    ],
    "description": "Create a new Promise"
  },
  "Try Catch": {
    "prefix": "try",
    "body": [
      "try {",
      "  $1",
      "} catch (error) {",
      "  console.error(error);",
      "}"
    ],
    "description": "Try catch block"
  },
  "Try Catch Finally": {
    "prefix": "tryf",
    "body": [
      "try {",
      "  $1",
      "} catch (error) {",
      "  console.error(error);",
      "} finally {",
      "  $2",
      "}"
    ],
    "description": "Try catch finally block"
  },
  "For Loop": {
    "prefix": "for",
    "body": [
      "for (let i = 0; i < $1; i++) {",
      "  $2",
      "}"
    ],
    "description": "For loop"
  },
  "For Of Loop": {
    "prefix": "forof",
    "body": [
      "for (const $1 of $2) {",
      "  $3",
      "}"
    ],
    "description": "For of loop"
  },
  "For In Loop": {
    "prefix": "forin",
    "body": [
      "for (const $1 in $2) {",
      "  $3",
      "}"
    ],
    "description": "For in loop"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while ($1) {",
      "  $2",
      "}"
    ],
    "description": "While loop"
  },
  "If Statement": {
    "prefix": "if",
    "body": [
      "if ($1) {",
      "  $2",
      "}"
    ],
    "description": "If statement"
  },
  "If Else": {
    "prefix": "ifelse",
    "body": [
      "if ($1) {",
      "  $2",
      "} else {",
      "  $3",
      "}"
    ],
    "description": "If else statement"
  },
  "Array Map": {
    "prefix": "map",
    "body": [
      "$1.map($2 => $3)"
    ],
    "description": "Array map"
  },
  "Array Filter": {
    "prefix": "filter",
    "body": [
      "$1.filter($2 => $3)"
    ],
    "description": "Array filter"
  },
  "Array Reduce": {
    "prefix": "reduce",
    "body": [
      "$1.reduce((acc, $2) => {",
      "  $3",
      "  return acc;",
      "}, $4)"
    ],
    "description": "Array reduce"
  },
  "Array Find": {
    "prefix": "find",
    "body": [
      "$1.find($2 => $3)"
    ],
    "description": "Array find"
  },
  "Array ForEach": {
    "prefix": "foreach",
    "body": [
      "$1.forEach($2 => {",
      "  $3",
      "});"
    ],
    "description": "Array forEach"
  },
  "Destructuring": {
    "prefix": "dest",
    "body": [
      "const { $1 } = $2;"
    ],
    "description": "Object destructuring"
  },
  "Array Destructuring": {
    "prefix": "destarray",
    "body": [
      "const [$1] = $2;"
    ],
    "description": "Array destructuring"
  },
  "Spread Operator": {
    "prefix": "spread",
    "body": [
      "...$1"
    ],
    "description": "Spread operator"
  },
  "Object Shorthand": {
    "prefix": "obj",
    "body": [
      "const $1 = {",
      "  $2: $2",
      "};"
    ],
    "description": "Object shorthand property"
  },
  "Fetch GET": {
    "prefix": "fetchget",
    "body": [
      "fetch('$1')",
      "  .then(response => response.json())",
      "  .then(data => console.log(data))",
      "  .catch(error => console.error(error));"
    ],
    "description": "Fetch GET request"
  },
  "Fetch POST": {
    "prefix": "fetchpost",
    "body": [
      "fetch('$1', {",
      "  method: 'POST',",
      "  headers: {",
      "    'Content-Type': 'application/json'",
      "  },",
      "  body: JSON.stringify($2)",
      "})",
      "  .then(response => response.json())",
      "  .then(data => console.log(data))",
      "  .catch(error => console.error(error));"
    ],
    "description": "Fetch POST request"
  },
  "Class Declaration": {
    "prefix": "class",
    "body": [
      "class $1 {",
      "  constructor($2) {",
      "    $3",
      "  }",
      "",
      "  $4() {",
      "    $5",
      "  }",
      "}"
    ],
    "description": "Class declaration"
  },
  "Constructor": {
    "prefix": "constructor",
    "body": [
      "constructor($1) {",
      "  $2",
      "}"
    ],
    "description": "Constructor method"
  },
  "Method": {
    "prefix": "method",
    "body": [
      "$1($2) {",
      "  $3",
      "}"
    ],
    "description": "Class method"
  },
  "Async Function": {
    "prefix": "async",
    "body": [
      "async function $1($2) {",
      "  $3",
      "}"
    ],
    "description": "Async function"
  },
  "Await": {
    "prefix": "await",
    "body": [
      "const $1 = await $2;"
    ],
    "description": "Await expression"
  },
  "Module Export": {
    "prefix": "export",
    "body": [
      "export const $1 = $2;"
    ],
    "description": "Export constant"
  },
  "Module Export Default": {
    "prefix": "exportdef",
    "body": [
      "export default $1;"
    ],
    "description": "Export default"
  },
  "Module Import": {
    "prefix": "import",
    "body": [
      "import $1 from '$2';"
    ],
    "description": "Import module"
  },
  "Module Import Named": {
    "prefix": "importn",
    "body": [
      "import { $1 } from '$2';"
    ],
    "description": "Import named exports"
  },
  "Template Literal": {
    "prefix": "template",
    "body": [
      "`$1${$2}$3`"
    ],
    "description": "Template literal"
  },
  "Ternary Operator": {
    "prefix": "ternary",
    "body": [
      "$1 ? $2 : $3"
    ],
    "description": "Ternary operator"
  },
  "Logical AND": {
    "prefix": "and",
    "body": [
      "$1 && $2"
    ],
    "description": "Logical AND operator"
  },
  "Logical OR": {
    "prefix": "or",
    "body": [
      "$1 || $2"
    ],
    "description": "Logical OR operator"
  }
}